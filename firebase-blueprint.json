{
  "entities": {
    "Message": {
      "title": "Message",
      "description": "Chat message between doctor and patient",
      "type": "object",
      "properties": {
        "patientId": { "type": "string" },
        "sender": { "type": "string" },
        "text": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "sender", "text", "timestamp"]
    },
    "Patient": {
      "title": "Patient",
      "description": "Cardiology clinic patient medical record and user profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authUid": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "dob": { "type": "string" },
        "status": { "type": "string" },
        "diagnosis": { "type": "string" },
        "securityToken": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "Vital": {
      "title": "Vital",
      "description": "Blood pressure and heart rate measurement logged by patient or clinic",
      "type": "object",
      "properties": {
        "systolic": { "type": "number" },
        "diastolic": { "type": "number" },
        "heartRate": { "type": "number" },
        "patientId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["systolic", "diastolic", "patientId", "timestamp"]
    },
    "Plan": {
      "title": "Plan",
      "description": "Dynamic customizable subscription tier configured by platform admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "billingCycle": { "type": "string" },
        "maxPatients": { "type": "number" },
        "aiMonthlyQuota": { "type": "number" },
        "isDefault": { "type": "boolean" },
        "badgeColor": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "price", "billingCycle"]
    },
    "Doctor": {
      "title": "Doctor",
      "description": "Cardiologist practitioner clinic profile and subscription status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "clinicCode": { "type": "string" },
        "clinicName": { "type": "string" },
        "specialty": { "type": "string" },
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "status": { "type": "string" },
        "aiQueriesUsed": { "type": "number" },
        "aiQuotaLimit": { "type": "number" },
        "isAiBlocked": { "type": "boolean" }
      },
      "required": ["id", "name", "clinicCode"]
    },
    "Lab": {
      "title": "Lab",
      "description": "Diagnostic medical laboratory partner profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "labCode": { "type": "string" },
        "technicianName": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "labCode"]
    }
  },
  "firestore": {
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Collection of chat messages"
    },
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "Collection of patient clinical files"
    },
    "/patients/{patientId}/vitals/{vitalId}": {
      "schema": "Vital",
      "description": "Subcollection of vital sign readings"
    },
    "/plans/{planId}": {
      "schema": "Plan",
      "description": "Dynamic subscription tiers managed by platform super admin"
    },
    "/doctors/{doctorId}": {
      "schema": "Doctor",
      "description": "Cardiologist accounts and subscription quotas"
    },
    "/labs/{labId}": {
      "schema": "Lab",
      "description": "Diagnostic laboratory partner accounts"
    }
  }
}
